{
  "name": "order-email-extraction",
  "private": true,
  "version": "1.0.0",
  "description": "Reads a mailbox and rebuilds the life of an order from it, saying where every field came from.",
  "author": "Riccardo Sapuppo",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start": "npm run build && node packages/server/build/src/main.js",
    "extract": "node tools/extract.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
